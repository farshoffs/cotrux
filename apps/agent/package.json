{
  "name": "@cotrux/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cotrux.agent",
    "productName": "Cotrux",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "executableName": "Cotrux"
  },
  "description": "Cotrux consent-first remote desktop host agent",
  "author": "Cotrux"
}
